# CFI-Fed production integration template (copy to production.env and fill in)
# Honesty: stubs and benchmarks are not production attestation.

# --- Federation (ingress path prefixes match compose/nginx/Helm) ---
CFI_REGISTRY_URL=https://cfi-fed.example.com/registry
CFI_COORDINATOR_URL=https://cfi-fed.example.com/coordinator
CFI_AGGREGATOR_URL=https://cfi-fed.example.com/aggregator

# --- TLS / mTLS ---
CFI_TLS_VERIFY=1
# CFI_TLS_CA_BUNDLE=/path/to/ca-bundle.pem
# CFI_MTLS_CLIENT_CERT=/path/to/client.pem
# CFI_MTLS_CLIENT_KEY=/path/to/client-key.pem

# --- Live AgentRx / CausalFlow hooks (set CFI_HOOK_MODE=live) ---
CFI_HOOK_MODE=live
CFI_AGENTRX_URL=https://agentrx.internal/v1/replay
CFI_CAUSALFLOW_URL=https://causalflow.internal/v1/counterfactual
# CFI_REPLAY_MOCK_URL=https://replay.internal/replay
# CFI_TAU_BENCH_URL=https://tau.internal/v1/tasks

# --- Registry / security ---
CFI_DATABASE_URL=postgresql://cfi:SECRET@postgres:5432/cfi
CFI_API_TOKEN=replace-with-bearer-token
CFI_MINIMUM_COHORT_K=10
CFI_TOTAL_EPSILON=10.0

# --- Audit sink ---
# CFI_AUDIT_SINK_URL=https://siem.internal/audit
# CFI_AUDIT_SINK_SIGNED=1
# CFI_AUDIT_SINK_WORM=1
# CFI_AUDIT_SINK_IDEMPOTENCY=1
